local pdCache, pdCacheTime = {}, 0
local PD_TTL = 0.4
local function getPlayerData()
    local now = tick()
    if (now - pdCacheTime) < PD_TTL then return pdCache end
    local ok, data = pcall(function() return Extras.GetPlayerData:InvokeServer() end)
    if ok and type(data) == "table" then pdCache = data; pdCacheTime = now; return data end
    return pdCache
end

local function findRole(role)
    local data = getPlayerData()
    for name, info in pairs(data) do
        if name ~= player.Name and type(info) == "table" and info.Role == role and not info.Dead and not info.Killed then
            local pl = Players:FindFirstChild(name)
            if pl and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
                return pl
            end
        end
    end
    return nil
end

local function myData()
