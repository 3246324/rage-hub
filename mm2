end

local function updateCham(pl, role, dead)
    local char = pl.Character
    if not char or dead then clearCham(pl); return end
    local color = ROLE_COLORS[role] or ROLE_COLORS.Innocent
    local h = espChams[pl]
    if not h or not h.Parent then
        h = Instance.new("Highlight")
        h.Name = "MM2Cham"
        h.FillTransparency = 0.5
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = char
        h.Parent = char
        espChams[pl] = h
    end
    h.FillColor = color
    h.OutlineColor = color
    if h.Adornee ~= char then h.Adornee = char end
    if h.Parent ~= char then h.Parent = char end
end

