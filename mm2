local function isTrapPart(obj)
    if not obj:IsA("BasePart") then return false end
    if not obj.Name:lower():find("trap") then return false end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character and obj:IsDescendantOf(pl.Character) then return false end
    end
    return true
end

local function espUpdateTraps()
    local seen = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isTrapPart(obj) then
            seen[obj] = true
            if not espTrapHLs[obj] or not espTrapHLs[obj].Parent then
                local h = Instance.new("Highlight")
                h.Name = "MM2Trap"
                h.FillColor = Color3.fromRGB(255, 100, 0)
                h.OutlineColor = Color3.fromRGB(255, 100, 0)
                h.FillTransparency = 0.3
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Adornee = obj
                h.Parent = obj
                espTrapHLs[obj] = h
            end
        end
    end
    for p, h in pairs(espTrapHLs) do
        if not seen[p] or not p.Parent then
            pcall(function() h:Destroy() end)
            espTrapHLs[p] = nil
        end
    end
end

local espTracers = {}
local function clearTracers()
    for pl, ln in pairs(espTracers) do pcall(function() ln:Remove() end) end
    espTracers = {}
end

local espFrame = 0
track(RunService.Heartbeat:Connect(function()
    espFrame = espFrame + 1
    if espFrame % 2 ~= 0 then return end

    local wantData = cfg.ESP_Chams or cfg.ESP_Nametags or cfg.ESP_Tracers
    if wantData then
        local data = getPlayerData()
        local seen = {}
        local cam = Workspace.CurrentCamera
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= player then
                seen[pl] = true
                local info = data[pl.Name]
                local role = info and info.Role or "Innocent"
                local perk = info and info.Perk or ""
                local dead = info and (info.Dead or info.Killed)

                if cfg.ESP_Chams then updateCham(pl, role, dead) end
                if cfg.ESP_Nametags then updateTag(pl, role, perk, dead) end

                if cfg.ESP_Tracers and not dead and cam and hrp then
                    local tHrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                    if tHrp then
                        local pos, vis = cam:WorldToViewportPoint(tHrp.Position)
                        if vis then
                            local color = ROLE_COLORS[role] or ROLE_COLORS.Innocent
                            local ln = espTracers[pl]
                            if not ln and type(Drawing) == "table" then
                                ln = Drawing.new("Line")
                                ln.Thickness = 1.5
                                ln.Transparency = 0.6
                                espTracers[pl] = ln
                            end
                            if ln then
                                ln.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                                ln.To = Vector2.new(pos.X, pos.Y)
                                ln.Color = color
                                ln.Visible = true
                            end
                        else
                            if espTracers[pl] then espTracers[pl].Visible = false end
                        end
                    end
                end
            end
        end
        for pl in pairs(espChams) do if not seen[pl] then clearCham(pl) end end
        for pl in pairs(espTags) do if not seen[pl] then clearTag(pl) end end
        for pl, ln in pairs(espTracers) do
            if not seen[pl] then pcall(function() ln:Remove() end); espTracers[pl] = nil end
        end
    end

    if not cfg.ESP_Chams and next(espChams) then
        for pl in pairs(espChams) do clearCham(pl) end
    end
    if not cfg.ESP_Nametags and next(espTags) then
        for pl in pairs(espTags) do clearTag(pl) end
    end
    if not cfg.ESP_Tracers and next(espTracers) then clearTracers() end

    if cfg.ESP_GunDrop then espUpdateGun() else clearGunESP() end

    if cfg.ESP_Traps and espFrame % 10 == 0 then espUpdateTraps()
    elseif not cfg.ESP_Traps and next(espTrapHLs) then clearTrapESP() end
end))

