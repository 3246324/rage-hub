local function validateKey(key, callback)
    if not httpRequest then
        callback(false, "HTTP not supported by this executor")
        return
    end
    local hwid = getHWID()
    task.spawn(function()
        local ok, result = pcall(function()
            return httpRequest({
                Url = KEY_API_URL .. "/validate",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ key = key, hwid = hwid }),
            })
        end)
        if ok and result and result.Body then
            local success, data = pcall(function()
                return HttpService:JSONDecode(result.Body)
            end)
            if success and data and data.valid then
                isPremium = true
                pcall(function() writefile("MM2Hub/premium.key", key) end)
                callback(true, data.message or "Key activated")
            elseif success and data then
                callback(false, data.error or "Invalid key")
            else
                callback(false, "Bad response from key server")
            end
        else
            callback(false, "Could not reach key server")
        end
    end)
end

