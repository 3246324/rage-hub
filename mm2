local function premiumToggle(parent, flag, opts, realCallback)
    if not isPremium then
        opts.Title = opts.Title .. " 🔒"
        opts.Description = "Premium — unlock with a key"
        opts.Default = false
    end
    local toggle
    opts.Callback = function(v)
        if not isPremium and v then
            if toggle then toggle:SetValue(false) end
            Fluent:Notify({Title = "Premium Required", Content = "Get a key from our Discord.", Type = "Warning", Duration = 3})
            return
        end
        realCallback(v)
    end
    toggle = parent:AddToggle(flag, opts)
    return toggle
end

local function premiumSlider(parent, flag, opts, realCallback)
    if not isPremium then
        opts.Title = opts.Title .. " 🔒"
        opts.Description = "Premium — unlock with a key"
    end
    local init = true
    opts.Callback = function(v)
        if not isPremium then
            if not init then
                Fluent:Notify({Title = "Premium Required", Content = "Get a key from our Discord.", Type = "Warning", Duration = 3})
            end
            return
        end
        realCallback(v)
    end
    local slider = parent:AddSlider(flag, opts)
    init = false
    return slider
end

