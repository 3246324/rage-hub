    hrp.AssemblyLinearVelocity = Vector3.zero
end

findClosestRole = function(role)
    local data = getPlayerData()
    local bestPl, bestDist = nil, math.huge
    for name, info in pairs(data) do
        if name ~= player.Name and type(info) == "table" and info.Role == role
            and not info.Dead and not info.Killed then
            local pl = Players:FindFirstChild(name)
            if pl and pl.Character then
                local oh = pl.Character:FindFirstChild("HumanoidRootPart")
                if oh and hrp then
                    local d = (oh.Position - hrp.Position).Magnitude
                    if d < bestDist then bestDist = d; bestPl = pl end
                end
            end
        end
    end
    return bestPl
end

local function gunAuraStep()
    local gun = getGun()
    if not gun or not amAlive() or not gunReady(gun) then return end
    local target
    if isInfection() then
        if myRole() ~= "Survivor" then return end
        target = findClosestRole("Zombie")
    else
        target = findRole("Murderer")
    end
    if not target then return end
    local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if thrp and hrp and (hrp.Position - thrp.Position).Magnitude <= cfg.GunAuraRange then
        local g = equipGun()
        if not g then return end
        local shoot = g:FindFirstChild("Shoot")
        if not shoot then return end
        local origin = CFrame.new(thrp.Position + Vector3.new(0, 3, 0), thrp.Position)
        local tgt = CFrame.new(predictHit(thrp))
        pcall(function() shoot:FireServer(origin, tgt) end)
    end
end

