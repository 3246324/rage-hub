local function killPlayer(targetPlayer)
    if myRole() ~= "Murderer" or not amAlive() then return end
    local ev = knifeEvents()
    if not ev then return end
    local tchar = targetPlayer and targetPlayer.Character
    local thrp = tchar and tchar:FindFirstChild("HumanoidRootPart")
    if not thrp then return end
    pcall(function() ev.KnifeStabbed:FireServer() end)
    pcall(function() ev.HandleTouched:FireServer(thrp) end)
end

local function killAll()
    if myRole() ~= "Murderer" or not amAlive() then return end
    local ev = knifeEvents()
    if not ev then return end
    pcall(function() ev.KnifeStabbed:FireServer() end)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= player and pl.Character and playerAlive(pl) then
            local thrp = pl.Character:FindFirstChild("HumanoidRootPart")
            if thrp then pcall(function() ev.HandleTouched:FireServer(thrp) end) end
        end
    end
end

local function killAuraStep()
    if myRole() ~= "Murderer" or not amAlive() or not hrp then return end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= player and pl.Character and playerAlive(pl) then
            local ohrp = pl.Character:FindFirstChild("HumanoidRootPart")
            if ohrp and (hrp.Position - ohrp.Position).Magnitude <= cfg.KillAuraRange then
                killPlayer(pl)
            end
        end
    end
end

local flingBusy = false

local function flingPlayer(targetPlayer)
    if flingBusy or not targetPlayer or not targetPlayer.Character then return end
    local thrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not thrp or not hrp or not hrp.Parent then return end
    flingBusy = true

    local save = hrp.CFrame
    local oldFall = Workspace.FallenPartsDestroyHeight
    pcall(function() Workspace.FallenPartsDestroyHeight = math.huge end)

    local prevCollide = {}
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") then prevCollide[p] = p.CanCollide; p.CanCollide = true end
    end

    local function targetAlive()
        return thrp and thrp.Parent and hrp and hrp.Parent
    end
    local function wasLaunched()
        return thrp and thrp.Parent and thrp.AssemblyLinearVelocity.Magnitude > 500
    end

    local launched = false
    local t0

    do
        local bav = Instance.new("BodyAngularVelocity")
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.AngularVelocity = Vector3.new(0, 200, 200)
        bav.P = 1e6
        bav.Parent = hrp

        t0 = tick()
        while tick() - t0 < 1.8 and targetAlive() do
            if wasLaunched() then launched = true; break end
            hrp.CFrame = thrp.CFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            RunService.Heartbeat:Wait()
        end
        pcall(function() bav:Destroy() end)
    end

    if not launched and targetAlive() then
        local bav = Instance.new("BodyAngularVelocity")
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.AngularVelocity = Vector3.new(150, 300, 150)
        bav.P = 1e6
        bav.Parent = hrp

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e8, 9e8, 9e8)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp

        t0 = tick()
        while tick() - t0 < 1.8 and targetAlive() do
            if wasLaunched() then launched = true; break end
            hrp.CFrame = CFrame.new(thrp.Position + Vector3.new(0, 0.5, 0), thrp.Position)
            bv.Velocity = (thrp.Position - hrp.Position).Unit * 600
            RunService.Heartbeat:Wait()
        end
        pcall(function() bav:Destroy() end)
        pcall(function() bv:Destroy() end)
    end

    if not launched and targetAlive() then
        local bav = Instance.new("BodyAngularVelocity")
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.AngularVelocity = Vector3.new(100, 100, 100)
        bav.P = 1e6
        bav.Parent = hrp

        local inside = true
        t0 = tick()
        while tick() - t0 < 2 and targetAlive() do
            if wasLaunched() then launched = true; break end
            if inside then
                hrp.CFrame = thrp.CFrame
                hrp.AssemblyLinearVelocity = (thrp.Position - hrp.Position).Unit * 400
            else
                local off = Vector3.new(
                    math.random() * 3 - 1.5,
                    math.random() * 2,
                    math.random() * 3 - 1.5
                )
                hrp.CFrame = CFrame.new(thrp.Position + off, thrp.Position)
            end
            inside = not inside
            RunService.Heartbeat:Wait()
        end
        pcall(function() bav:Destroy() end)
    end

    if not launched and targetAlive() then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e8, 9e8, 9e8)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp

        local bav = Instance.new("BodyAngularVelocity")
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.AngularVelocity = Vector3.new(200, 0, 200)
        bav.P = 1e6
        bav.Parent = hrp

        t0 = tick()
        while tick() - t0 < 2 and targetAlive() do
            if wasLaunched() then launched = true; break end
            hrp.CFrame = CFrame.new(thrp.Position + Vector3.new(0, 4, 0), thrp.Position)
            bv.Velocity = Vector3.new(0, -1200, 0)
            RunService.Heartbeat:Wait()
            if wasLaunched() then launched = true; break end
            hrp.CFrame = thrp.CFrame
            bv.Velocity = Vector3.new(0, -800, 0)
            RunService.Heartbeat:Wait()
        end
        pcall(function() bv:Destroy() end)
        pcall(function() bav:Destroy() end)
    end

    for p, cc in pairs(prevCollide) do if p and p.Parent then p.CanCollide = cc end end
    pcall(function() Workspace.FallenPartsDestroyHeight = oldFall end)

    if hrp and hrp.Parent then
        hrp.CFrame = save
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if launched then
        print("[Rage] Fling landed")
    else
        print("[Rage] Fling timeout — target might have anti-fling")
    end

    flingBusy = false
end
