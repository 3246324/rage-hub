local function shootPos(targetPos, fromAnywhere)
    local gun = equipGun()
    if not gun then return false end
    local shoot = gun:FindFirstChild("Shoot")
    if not shoot then return false end

    local origin
    if fromAnywhere then
        origin = CFrame.new(targetPos + Vector3.new(0, 3, 0), targetPos)
    else
        local att = hrp:FindFirstChild("GunRaycastAttachment")
        origin = att and att.WorldCFrame or CFrame.new(hrp.Position)
    end
    local target = CFrame.new(targetPos)
    pcall(function() shoot:FireServer(origin, target) end)
    return true
end

local function gunReady(gun)
    local cs = gun and gun:FindFirstChild("CantShoot")
    return (not cs) or (not cs.Enabled)
end
local function waitGunReady(gun, timeout)
    local t0 = os.clock()
    while gun and gun.Parent do
        if gunReady(gun) then return true end
        if os.clock() - t0 > (timeout or 6) then return false end
        task.wait()
    end
    return false
end

local Stats = game:GetService("Stats")
local function getNetworkLead()
    local ok, ping = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    if ok and ping and ping > 0 then return ping * 1.15 end
    local ok2, ping2 = pcall(function() return player:GetNetworkPing() end)
    if ok2 and ping2 and ping2 > 0 then return ping2 * 1.15 end
    return cfg.ShotLead
end

local function predictHit(part)
    local v = part.AssemblyLinearVelocity or Vector3.zero
    return part.Position + (v * getNetworkLead())
end

local function shootMurderer()
    print("[Rage] shootMurderer called, isInfection type:", type(isInfection), "findClosestRole type:", type(findClosestRole))
    if not amAlive() then print("[Rage] shootMurderer: not alive"); return false end
    if not equipGun() then return false end
    task.wait(0.15)
    local fired = false
    local infection = isInfection()
    while inRound and amAlive() do
        local m
        if infection then
            m = findClosestRole("Zombie")
        else
            m = findRole("Murderer")
        end
        if not m then return true end
        local mhrp = m.Character and m.Character:FindFirstChild("HumanoidRootPart")
        if mhrp then
            if getGun() then equipGun() end
            shootPos(predictHit(mhrp), true)
            shootPos(mhrp.Position, true)
            fired = true
        end
        task.wait(0.08)
    end
    return fired
end

local function grabGun()
    if myRole() == "Murderer" or myRole() == "Sheriff" then return end
    if not amAlive() or not hrp then return end
    local drop
    for _, c in ipairs(Workspace:GetDescendants()) do
        if c.Name == "GunDrop" and c:IsA("BasePart") then drop = c break end
    end
    if not drop then return end
    local save = hrp.CFrame
    for _ = 1, 10 do
        if not drop or not drop.Parent then break end
        hrp.CFrame = CFrame.new(drop.Position + Vector3.new(0, -4, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        pcall(function() firetouchinterest(hrp, drop, 1) end)
        pcall(function() firetouchinterest(hrp, drop, 0) end)
        RunService.Heartbeat:Wait()
    end
