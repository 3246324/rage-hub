local function ensureMovers()
    if holdAtt and holdAtt.Parent and alignP and alignP.Parent then return end
    if holdAtt then pcall(function() holdAtt:Destroy() end) end
    if alignP then pcall(function() alignP:Destroy() end) end
    if alignO then pcall(function() alignO:Destroy() end) end
    holdAtt = Instance.new("Attachment"); holdAtt.Name = "HubHoldAtt"; holdAtt.Parent = hrp
    alignP = Instance.new("AlignPosition"); alignP.Name = "HubAlignP"
    alignP.Mode = Enum.PositionAlignmentMode.OneAttachment; alignP.Attachment0 = holdAtt
    alignP.ApplyAtCenterOfMass = true; alignP.MaxForce = 1e8; alignP.MaxVelocity = math.huge
    alignP.Responsiveness = 200; alignP.Parent = hrp
    alignO = Instance.new("AlignOrientation"); alignO.Name = "HubAlignO"
    alignO.Mode = Enum.OrientationAlignmentMode.OneAttachment; alignO.Attachment0 = holdAtt
    alignO.MaxTorque = 1e8; alignO.Responsiveness = 200; alignO.Parent = hrp
end
local function startHold(pos)
    holding = true; ensureMovers()
    alignP.Position = pos; alignO.CFrame = LAY
    if humanoid then humanoid.PlatformStand = true end
    local an = humanoid:FindFirstChildWhichIsA("Animator")
    if an then for _, t in ipairs(an:GetPlayingAnimationTracks()) do t:Stop(0) end end
end
local function setHold(pos)
    if not alignP or not alignP.Parent then ensureMovers() end
    if alignP then alignP.Position = pos end
end
local function stopHold()
    holding = false; stopCameraFollow(); restoreClip()
    if alignP then pcall(function() alignP:Destroy() end); alignP = nil end
    if alignO then pcall(function() alignO:Destroy() end); alignO = nil end
    if holdAtt then pcall(function() holdAtt:Destroy() end); holdAtt = nil end
    if humanoid then humanoid.PlatformStand = false; humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
    if hrp and hrp.Parent then hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero end
end

