local function contested(coin)
    if not hrp or not coin or not coin.Parent then return false end
    local mine = (hrp.Position - coin.Position).Magnitude
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local oh = p.Character:FindFirstChild("HumanoidRootPart")
            local oHum = p.Character:FindFirstChildWhichIsA("Humanoid")
            if oh and (not oHum or oHum.Health > 0) then
                if (oh.Position - coin.Position).Magnitude < mine then return true end
            end
        end
    end
    return false
end
local infectionCache, lastModeCheck = false, 0
isInfection = function()
    if (tick() - lastModeCheck) > 1 then
        lastModeCheck = tick()
        infectionCache = false
        for _, info in pairs(getPlayerData()) do
            if type(info) == "table" and (info.Role == "Zombie" or info.Role == "Survivor") then
                infectionCache = true; break
            end
        end
    end
    return infectionCache
end

local threatChar, lastThreatCheck = nil, 0
getMurdererPos = function()
    if not cfg.AvoidMurderer then return nil end
    local role = myRole()
    if role == "Murderer" or role == "Zombie" then return nil end
    if (tick() - lastThreatCheck) > 0.5 or not (threatChar and threatChar.Parent) then
        lastThreatCheck = tick()
        if isInfection() then
            local bestPl, bestDist = nil, math.huge
            local data = getPlayerData()
            for name, info in pairs(data) do
                if name ~= player.Name and type(info) == "table" and info.Role == "Zombie"
                    and not info.Dead and not info.Killed then
                    local pl = Players:FindFirstChild(name)
                    if pl and pl.Character then
                        local oh = pl.Character:FindFirstChild("HumanoidRootPart")
                        if oh and hrp then
                            local d = (oh.Position - hrp.Position).Magnitude
                            if d < bestDist then bestDist = d; bestPl = pl end
                        end
                    end
                end
            end
            threatChar = bestPl and bestPl.Character or nil
        else
            local m = findRole("Murderer")
            threatChar = m and m.Character or nil
        end
    end
    local mh = threatChar and threatChar:FindFirstChild("HumanoidRootPart")
    return mh and mh.Position or nil
end

local function distPointSeg(p, a, b)
    local ab = b - a
    local denom = ab:Dot(ab)
    local t = denom > 0 and math.clamp((p - a):Dot(ab) / denom, 0, 1) or 0
    return (p - (a + ab * t)).Magnitude
end

local function pickCoin(coins)
    if not hrp then return nil end
    local role = myRole()
    local isMurderer = (role == "Murderer" or role == "Zombie")
    local mpos = getMurdererPos()
    local DANGER = cfg.MurdererDanger

    local pool = {}
    for _, coin in ipairs(coins) do
        if coin and coin.Parent and coin ~= stuckSkipCoin then
            local dominated = false
            if not isMurderer then
                if cfg.SkipContested and contested(coin) then dominated = true end
                if not dominated and cfg.AvoidMurderer and isPremium and mpos then
                    local cpos = coin.Position
                    if (cpos - mpos).Magnitude < DANGER then dominated = true
                    elseif distPointSeg(mpos, hrp.Position, cpos) < DANGER then dominated = true end
                end
            end
            if not dominated then table.insert(pool, coin) end
        end
    end

    if #pool == 0 then
        for _, coin in ipairs(coins) do
            if coin and coin.Parent and coin ~= stuckSkipCoin then
                table.insert(pool, coin)
            end
        end
    end
    if #pool == 0 then return nil end

    if cfg.CoinTarget == "Farthest" then
        table.sort(pool, function(a, b)
            return (a.Position - hrp.Position).Magnitude > (b.Position - hrp.Position).Magnitude
        end)
        return pool[1]
    elseif cfg.CoinTarget == "Random" then
        return pool[math.random(#pool)]
    else
        table.sort(pool, function(a, b)
            return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
        end)
        return pool[1]
    end
end
local function fireCoin(coin)
    if coin and coin.Parent then
        pcall(function() firetouchinterest(hrp, coin, 0) end)
        pcall(function() firetouchinterest(hrp, coin, 1) end)
    end
end

local farmHeartbeat = 0

local moveGoal = nil
local moveFrom = nil
local moveTime = 0
local moveElapsed = 0
local moveFlee = false
local moveIsGun = false
local moveGrabCoin = nil

local grabFrames = 0

local stuckCheckPos = nil
local stuckCheckTime = 0
local STUCK_DIST = 2.2
local STUCK_TIME = 3.2
local stuckSkipCoin = nil

local idleAccum = 0
local scanAccum = 0

local function farmBeginMove(dest, fleeing, isGun, coin)
    if not hrp or not hrp.Parent then return false end
    local dist = (hrp.Position - dest).Magnitude
    if dist < 1 then
        setHold(dest)
        return false
    end
    moveGoal = dest
    moveFrom = hrp.Position
    moveTime = math.max(dist / cfg.TWEEN_SPEED, 0.08)
    moveElapsed = 0
    moveFlee = fleeing or false
    moveIsGun = isGun or false
    moveGrabCoin = coin
    FARM_STATE = "move"
    return true
end

local function farmStep(dt)
    if FARM_STATE == "off" then return end

    farmHeartbeat = farmHeartbeat + 1
    if farmHeartbeat % 200 == 0 then
        print("[Rage] farm hb #" .. farmHeartbeat .. " st=" .. FARM_STATE
            .. " round=" .. tostring(inRound) .. " bag=" .. tostring(bagDone)
            .. " alive=" .. tostring(amAlive()))
    end

    if FARM_STATE == "busy" then
        if not farmBusy then FARM_STATE = "pick" end
        return
    end

    if FARM_STATE == "idle" then
        idleAccum = idleAccum + dt
        if idleAccum < 0.3 then return end
        idleAccum = 0

        if not character or not hrp or not hrp.Parent then return end
        if humanoid and humanoid.Health <= 0 then
            if holding then stopHold() end
            bagDone = false; roundSpawn = nil
            return
        end
        if not inRound then
            if holding then stopHold() end
            inRound = checkRoundActive()
            return
        end
        if not amAlive() then
            if holding then stopHold() end
            return
        end
        FARM_STATE = "pick"
        return
    end

    if FARM_STATE == "scan" then
        scanAccum = scanAccum + dt
        if scanAccum >= cfg.SCAN_DELAY then
            scanAccum = 0
            if stuckSkipCoin and (not stuckSkipCoin.Parent) then stuckSkipCoin = nil end
            FARM_STATE = "pick"
        end
        return
    end

    if FARM_STATE == "arrive" then
        grabFrames = grabFrames + 1
        if grabFrames < 3 then return end
        local fired = 0
        if moveGrabCoin and moveGrabCoin.Parent then
            fireCoin(moveGrabCoin); fired = 1
        end
        if isPremium and cfg.CoinAura and fired < cfg.COINS_PER_SWEEP
            and (os.clock() - lastAura) >= cfg.SWEEP_INTERVAL then
            lastAura = os.clock()
            local nearby = {}
            for _, c in ipairs(getCoins()) do
                if c ~= moveGrabCoin and c.Parent
                    and (not cfg.SkipContested or not contested(c))
                    and hrp and (hrp.Position - c.Position).Magnitude <= cfg.AURA_RANGE then
                    table.insert(nearby, c)
                end
            end
            table.sort(nearby, function(a,b)
                return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
            end)
            for _, c in ipairs(nearby) do
                if fired >= cfg.COINS_PER_SWEEP then break end
                fireCoin(c); fired = fired + 1
            end
        end
        moveGrabCoin = nil
        scanAccum = 0
        FARM_STATE = "scan"
        return
    end

    if FARM_STATE == "move" then
        if not hrp or not hrp.Parent or not FARM_ENABLED or not inRound then
            FARM_STATE = "idle"; return
        end

        if cfg.FarmMethod == "Teleport" and not moveFlee then
            -- chunked teleport: step in <=35 stud increments to avoid invalid-position kick
            local TP_CHUNK = 35
            local from = hrp.Position
            local dist = (moveGoal - from).Magnitude
            if dist > TP_CHUNK then
                local dir = (moveGoal - from).Unit
                local steps = math.ceil(dist / TP_CHUNK)
                for i = 1, steps do
                    if not hrp or not hrp.Parent or not FARM_ENABLED then break end
                    local pos = (i == steps) and moveGoal or (from + dir * (TP_CHUNK * i))
                    setHold(pos)
                    RunService.Heartbeat:Wait()
                end
            else
                setHold(moveGoal)
            end
            stuckCheckPos = nil
            if moveIsGun then
                local drop = findGunDrop()
                if drop and drop.Parent then
                    for _ = 1, 4 do
                        pcall(function() firetouchinterest(hrp, drop, 1) end)
                        pcall(function() firetouchinterest(hrp, drop, 0) end)
                    end
                end
                FARM_STATE = "pick"
            elseif moveGrabCoin then
                grabFrames = 0
                FARM_STATE = "arrive"
            else
                FARM_STATE = "pick"
            end
            return
        end

        moveElapsed = moveElapsed + dt
        if not moveFlee and cfg.AvoidMurderer then
            local mp = getMurdererPos()
            if mp and (hrp.Position - mp).Magnitude < cfg.MurdererDanger then
                FARM_STATE = "pick"; return
            end
        end
        if not stuckCheckPos then
            stuckCheckPos = hrp.Position
            stuckCheckTime = tick()
        elseif (tick() - stuckCheckTime) >= STUCK_TIME then
            if (hrp.Position - stuckCheckPos).Magnitude < STUCK_DIST then
                print("[Rage] Stuck detected — skipping coin")
                stuckSkipCoin = moveGrabCoin
                stuckCheckPos = nil
                FARM_STATE = "pick"; return
            end
            stuckCheckPos = hrp.Position
            stuckCheckTime = tick()
        end
        local alpha = math.min(moveElapsed / moveTime, 1)
        setHold(moveFrom:Lerp(moveGoal, alpha))
        if alpha >= 1 then
            stuckCheckPos = nil
            if moveIsGun then
                local drop = findGunDrop()
                if drop and drop.Parent then
                    for _ = 1, 4 do
                        pcall(function() firetouchinterest(hrp, drop, 1) end)
                        pcall(function() firetouchinterest(hrp, drop, 0) end)
                    end
                end
                FARM_STATE = "pick"
            elseif moveGrabCoin then
                grabFrames = 0
                FARM_STATE = "arrive"
            else
                FARM_STATE = "pick"
            end
        end
        return
    end

    if FARM_STATE == "bag_full" then
        if hrp and hrp.Parent then
            if holding then setHold(hrp.Position) else startHold(hrp.Position) end
        end
        local role = myRole()
        if cfg.FarmXP and (role == "Murderer" or role == "Zombie") then
            farmBusy = true; FARM_STATE = "busy"
            task.spawn(function()
                for _ = 1, 12 do
                    local r = myRole()
                    if not (FARM_ENABLED and (r == "Murderer" or r == "Zombie") and amAlive()) then break end
                    local anyAlive = false
                    for _, pl in ipairs(Players:GetPlayers()) do
                        if pl ~= player and playerAlive(pl) then anyAlive = true; break end
                    end
                    if not anyAlive then break end
                    pcall(killAll); task.wait(0.25)
                end
                stopHold()
                if roundSpawn and hrp and hrp.Parent then hrp.CFrame = roundSpawn end
                farmBusy = false
            end)
        elseif isInfection() and role == "Survivor" then
            stopHold()
            pcall(function() character:BreakJoints() end)
            FARM_STATE = "idle"
        elseif getGun() then
            farmBusy = true; FARM_STATE = "busy"
            task.spawn(function()
                pcall(shootMurderer)
                farmBusy = false
            end)
        else
            farmBusy = true; FARM_STATE = "busy"
            task.spawn(function()
                print("[Rage] Bag full, no gun — fling murderer")
                stopHold()
                local mur = findRole("Murderer")
                if mur then pcall(function() flingPlayer(mur) end) end
                if hrp and hrp.Parent and roundSpawn then
                    hrp.CFrame = roundSpawn
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
                farmBusy = false
            end)
        end
        return
    end

    if FARM_STATE ~= "pick" then return end

    if not character or not hrp or not hrp.Parent then FARM_STATE = "idle"; return end
    if humanoid and humanoid.Health <= 0 then
        if holding then stopHold() end
        bagDone = false; roundSpawn = nil
        FARM_STATE = "idle"; return
    end
    if not inRound then
        if holding then stopHold() end; FARM_STATE = "idle"; return
    end
    if not amAlive() then
        if holding then stopHold() end; FARM_STATE = "idle"; return
    end

    if bagDone then
        if not isInfection() and getGun() then
            local m = findRole("Murderer")
            if not m then
                stopHold()
                if roundSpawn and hrp and hrp.Parent then hrp.CFrame = roundSpawn end
            end
        end
        FARM_STATE = "idle"; return
    end

    if coinsCollected >= bagCapacity then
        print("[Rage] Bag full (" .. coinsCollected .. "/" .. bagCapacity .. "), role=" .. tostring(myRole()))
        bagDone = true; FARM_STATE = "bag_full"; return
    end

    local coins = getCoins()
    if #coins == 0 then
        if holding then stopHold() end; FARM_STATE = "idle"; return
    end

    if math.abs(hrp.Position.Y - coins[1].Position.Y) > 100 then
        if holding then stopHold() end
        if roundSpawn and hrp and hrp.Parent then
            hrp.CFrame = roundSpawn
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        FARM_STATE = "idle"; return
    end

    if not roundSpawn and hrp and hrp.Parent then roundSpawn = hrp.CFrame end
    if holding and (not alignP or not alignP.Parent) then holding = false end
    if not holding then startHold(hrp.Position); startCameraFollow() end

    if isPremium and cfg.AvoidMurderer then
        local mp = getMurdererPos()
        if mp and (hrp.Position - mp).Magnitude < cfg.MurdererDanger then
            local target, bestDist = nil, math.huge
            for _, c in ipairs(coins) do
                if c and c.Parent then
                    local md = (c.Position - mp).Magnitude
                    local myDist = (hrp.Position - c.Position).Magnitude
                    if md > cfg.MurdererDanger and myDist < bestDist then
                        bestDist = myDist; target = c
                    end
                end
            end
            if target then
                if not farmBeginMove(target.Position + Vector3.new(0, cfg.COIN_OFFSET, 0), true, false, target) then
                    moveGrabCoin = target; grabFrames = 0; FARM_STATE = "arrive"
                end
                return
            end
            local fleeTo
            if roundSpawn and (roundSpawn.Position - mp).Magnitude > (hrp.Position - mp).Magnitude + 10 then
                fleeTo = roundSpawn.Position
            else
                local away = hrp.Position - mp
                if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
                fleeTo = hrp.Position + away.Unit * (cfg.MurdererDanger * 1.6)
            end
            farmBeginMove(fleeTo, true, false, nil)
            return
        end
    end

    local myR = myRole()
    if not amAlive() then FARM_STATE = "idle"; return end
    if (cfg.FarmXP or cfg.AutoGrabGun) and myR ~= "Murderer" and myR ~= "Zombie" and myR ~= "Sheriff" and not getGun() then
        if gunHuntStart == 0 then gunHuntStart = tick() end
        local drop = findGunDrop()
        if drop then
            for _ = 1, 4 do
                if not drop or not drop.Parent then break end
                pcall(function() firetouchinterest(hrp, drop, 1) end)
                pcall(function() firetouchinterest(hrp, drop, 0) end)
            end
            if not getGun() and drop and drop.Parent then
                farmBeginMove(drop.Position, false, true, nil)
                return
            end
            return
        end
        if cfg.FlingSheriff and not isInfection() and (tick() - lastFling) > 3 then
            local holder = findGunHolder()
            if holder then
                lastFling = tick()
                if holding then stopHold() end
                farmBusy = true; FARM_STATE = "busy"
                task.spawn(function()
                    pcall(function() flingPlayer(holder) end)
                    if hrp and hrp.Parent and roundSpawn then
                        hrp.CFrame = roundSpawn
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                    farmBusy = false
                end)
                return
            end
        end
    end

    coins = getCoins()
    if #coins > 0 then
        local t = pickCoin(coins)
        if t then
            if not farmBeginMove(t.Position + Vector3.new(0, cfg.COIN_OFFSET, 0), false, false, t) then
                moveGrabCoin = t; grabFrames = 0; FARM_STATE = "arrive"
            end
            return
        end
    end
    FARM_STATE = "idle"
end

local function setFarm(state)
    FARM_ENABLED = state
    if state then
        farmHeartbeat = 0
        farmBusy = false
        bagDone = false
        FARM_STATE = "idle"
        print("[Rage] setFarm ON (connection engine v2 — immune to thread GC)")
    else
        FARM_STATE = "off"
        farmBusy = false
        print("[Rage] setFarm OFF")
        stopHold()
    end
end

